{
  "name": "@kkucodes/dsh-predictions",
  "version": "1.0.0",
  "description": "DeepSeek Harness 独立预测消息插件；复用会话模型，输入框灰字接受。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKUCODES/deepseek-harness-predictions.git"
  },
  "homepage": "https://github.com/KKUCODES/deepseek-harness-predictions#readme",
  "bugs": { "url": "https://github.com/KKUCODES/deepseek-harness-predictions/issues" },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/", "cordis.patch.yml", "README.md", "README.en.md", "CHANGELOG.md", "docs/README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "node scripts/verify-stage1.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "verify:stage1": "node scripts/verify-stage1.mjs",
    "verify:status": "node scripts/verify-stage1.mjs --prediction-status --cached-model-from artifacts/stage2/2026-10-27T05-33-35-596Z-fb34b6d3/report.json",
    "verify:parameters": "node scripts/verify-stage1.mjs --custom-parameters --cached-model-from artifacts/stage2/2026-10-27T05-33-35-596Z-fb34b6d3/report.json",
    "verify:stage2": "node scripts/verify-stage1.mjs --real-model",
    "verify:stage3": "node scripts/verify-stage1.mjs --stage3 --cached-model-from artifacts/stage2/2026-10-27T05-33-35-596Z-fb34b6d3/report.json",
    "verify:settings": "node scripts/verify-stage1.mjs --stage3 --cached-model-from artifacts/stage2/2026-10-27T05-33-35-596Z-fb34b6d3/report.json",
    "verify:stage4": "node scripts/verify-stage1.mjs --stage4 --cached-model-from artifacts/stage2/2026-10-27T05-33-35-596Z-fb34b6d3/report.json"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.6",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dependencies": { "zod": "4.4.3" },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "0.25.12",
    "playwright": "1.55.1",
    "react": "18.3.1",
    "typescript": "5.9.3"
  }
}
